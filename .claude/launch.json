{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "explorer",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1"],
      "port": 8765
    },
    {
      "name": "assesshub",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "backend.app:app", "--host", "127.0.0.1", "--port", "8000", "--app-dir", "webapp"],
      "port": 8000
    },
    {
      "name": "atlas",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "webapp.backend.serve", "--no-browser", "--port", "8471"],
      "port": 8471
    },
    {
      "name": "master-reference",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "master-reference", "run", "dev"],
      "port": 3000
    }
  ]
}
