{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.invalid/schemas/atlas-r2-structural-tcb-census-v1.schema.json",
  "title": "Atlas R2 structural TCB census v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "budget_gate",
    "census_method",
    "conditional_legacy_replay_tcb",
    "executable_prototype",
    "implemented_guard_constants",
    "independent_review",
    "reference_runtime_dependencies",
    "reference_toolchain",
    "release3_included",
    "repository_basis",
    "structural_core"
  ],
  "properties": {
    "schema": { "const": "atlas.structural-tcb-census/1" },
    "release3_included": { "const": false },
    "budget_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_state", "core_sloc_budget", "pack_resource_ceilings", "pack_sloc_budget", "promotion_effect", "reason"],
      "properties": {
        "budget_state": {
          "enum": [
            "PROTOTYPE_MEASURED_PARTIAL_RUNTIME_TCB_PENDING_INDEPENDENT_REVIEW",
            "PROTOTYPE_MEASURED_COMPLETE_RUNTIME_TCB_PENDING_INDEPENDENT_REVIEW"
          ]
        },
        "core_sloc_budget": { "type": "null" },
        "pack_resource_ceilings": { "type": "null" },
        "pack_sloc_budget": { "type": "null" },
        "promotion_effect": { "const": "BLOCKS_R2_0_COMPLETION" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "census_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_statement_parser", "generator_bytes", "generator_path", "generator_sha256", "measurement_scope", "schema"],
      "properties": {
        "executable_statement_parser": { "type": "string", "pattern": "^coverage\\.py/[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "generator_bytes": { "$ref": "#/$defs/positiveInteger" },
        "generator_path": { "const": "tools/census_transition_tcb.py" },
        "generator_sha256": { "$ref": "#/$defs/digest" },
        "measurement_scope": { "const": "REFERENCE_ENVIRONMENT_OBSERVATION_WITH_PORTABLE_SOURCE_DIGEST_CHECK" },
        "schema": { "const": "atlas.python-executable-statement-census/1" }
      }
    },
    "conditional_legacy_replay_tcb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_source", "embedded_driver", "source_bundle_bytes", "source_bundle_file_count", "source_bundle_path", "source_bundle_sha256"],
      "properties": {
        "adapter_source": { "$ref": "#/$defs/source" },
        "embedded_driver": { "$ref": "#/$defs/embeddedSource" },
        "source_bundle_bytes": { "$ref": "#/$defs/positiveInteger" },
        "source_bundle_file_count": { "$ref": "#/$defs/positiveInteger" },
        "source_bundle_path": { "const": "cisco_toolkit/data/atlas-r1-source-bundle.json" },
        "source_bundle_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "executable_prototype": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_bindings",
        "baseline_receipt_digest",
        "claim_boundary",
        "execution_state",
        "interpreter_source",
        "measurement_tool",
        "pack_id",
        "pack_version",
        "promotion_eligible",
        "qcp_001_executed",
        "qualification_effect",
        "runtime_inventory",
        "runtime_inventory_state",
        "runtime_inventory_tool",
        "source_binding_state",
        "substrate",
        "wasm_execution_state"
      ],
      "properties": {
        "asset_bindings": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/fileBinding" }
        },
        "baseline_receipt_digest": { "$ref": "#/$defs/digest" },
        "claim_boundary": { "const": "Synthetic R2.0 executable conformance evidence only; not QCP-001, qualified, authoritative, portable, sandboxed, or promotion-eligible." },
        "execution_state": { "const": "DSL_ONLY_EXECUTABLE_NONAUTHORITATIVE" },
        "interpreter_source": { "$ref": "#/$defs/fileBinding" },
        "measurement_tool": { "$ref": "#/$defs/fileBinding" },
        "pack_id": { "const": "ATLAS-R2-DSL-CONFORMANCE" },
        "pack_version": { "const": "0.1.0-experimental" },
        "promotion_eligible": { "const": false },
        "qcp_001_executed": { "const": false },
        "qualification_effect": { "const": "NONE" },
        "runtime_inventory": { "$ref": "#/$defs/runtimeInventorySummary" },
        "runtime_inventory_state": {
          "enum": [
            "PARTIAL_NONPORTABLE_PROTOTYPE",
            "COMPLETE_EXACT_RUNTIME_CLOSURE"
          ]
        },
        "runtime_inventory_tool": { "$ref": "#/$defs/fileBinding" },
        "source_binding_state": { "const": "SAME_CHECKOUT_SELF_CHECK_ONLY" },
        "substrate": { "const": "DECLARATIVE_DSL_ONLY" },
        "wasm_execution_state": { "const": "UNIMPLEMENTED_UNREVIEWED" }
      }
    },
    "implemented_guard_constants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_json", "content_set", "dsl_prototype", "legacy_replay"],
      "properties": {
        "canonical_json": { "$ref": "#/$defs/guardSet" },
        "content_set": { "$ref": "#/$defs/guardSet" },
        "dsl_prototype": { "$ref": "#/$defs/dslGuardSet" },
        "legacy_replay": { "$ref": "#/$defs/guardSet" }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_next_evidence", "result", "review_evidence"],
      "properties": {
        "required_next_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "result": { "const": "PENDING_BOUND_INDEPENDENT_REVIEW_EVIDENCE" },
        "review_evidence": { "type": "null" }
      }
    },
    "reference_runtime_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/distribution" }
    },
    "reference_toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_tag", "executable_bytes", "executable_sha256", "implementation", "platform_machine", "platform_system", "python_version"],
      "properties": {
        "cache_tag": { "type": "string", "minLength": 1 },
        "executable_bytes": { "$ref": "#/$defs/positiveInteger" },
        "executable_sha256": { "$ref": "#/$defs/digest" },
        "implementation": { "type": "string", "minLength": 1 },
        "platform_machine": { "type": "string", "minLength": 1 },
        "platform_system": { "type": "string", "minLength": 1 },
        "python_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "repository_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_commit", "source_basis_parent_sha", "state"],
      "properties": {
        "selected_commit": { "type": "null" },
        "source_basis_parent_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "state": { "const": "EXACT_INPUT_DIGESTS_AWAIT_EXTERNAL_SELECTED_COMMIT_BINDING" }
      }
    },
    "structural_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_statements", "sources"],
      "properties": {
        "executable_statements": { "$ref": "#/$defs/positiveInteger" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executable_prototype": {
            "properties": {
              "runtime_inventory_state": { "const": "PARTIAL_NONPORTABLE_PROTOTYPE" }
            },
            "required": ["runtime_inventory_state"]
          }
        },
        "required": ["executable_prototype"]
      },
      "then": {
        "properties": {
          "budget_gate": {
            "properties": {
              "budget_state": { "const": "PROTOTYPE_MEASURED_PARTIAL_RUNTIME_TCB_PENDING_INDEPENDENT_REVIEW" }
            },
            "required": ["budget_state"]
          },
          "executable_prototype": {
            "properties": {
              "runtime_inventory": {
                "properties": {
                  "blind_spot_count": { "minimum": 1 },
                  "claim_boundary": { "const": "Exact-byte inventory of the observed isolated reference process and bounded static PE resolutions only; not portable closure, all-branch coverage, qualification, or promotion authority." },
                  "complete_exact_runtime_closure": { "const": false },
                  "state": { "const": "PARTIAL_NONPORTABLE_PROTOTYPE" }
                }
              }
            }
          },
          "independent_review": {
            "properties": {
              "required_next_evidence": {
                "const": [
                  "COMPLETE_EXACT_RUNTIME_DEPENDENCY_INVENTORY",
                  "INDEPENDENT_NUMERIC_BUDGET_APPROVAL",
                  "REPRESENTATIVE_WORKLOAD_ADEQUACY_EVIDENCE",
                  "APPROVED_REVIEW_POLICY_AND_TRUSTED_KEY_CUSTODY",
                  "SIGNED_REVIEW_RECEIPT_BOUND_TO_SELECTED_COMMIT_TREE_CENSUS_AND_MEASUREMENTS",
                  "SELECTED_COMMIT_BINDING"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executable_prototype": {
            "properties": {
              "runtime_inventory_state": { "const": "COMPLETE_EXACT_RUNTIME_CLOSURE" }
            },
            "required": ["runtime_inventory_state"]
          }
        },
        "required": ["executable_prototype"]
      },
      "then": {
        "properties": {
          "budget_gate": {
            "properties": {
              "budget_state": { "const": "PROTOTYPE_MEASURED_COMPLETE_RUNTIME_TCB_PENDING_INDEPENDENT_REVIEW" }
            },
            "required": ["budget_state"]
          },
          "executable_prototype": {
            "properties": {
              "runtime_inventory": {
                "properties": {
                  "blind_spot_count": { "const": 0 },
                  "claim_boundary": { "const": "Structurally complete exact-runtime closure review subject with no declared blind spots or unresolved native dependencies; these inventory bytes alone carry no closure, qualification, or promotion authority and require an independently verified review bound to their digest." },
                  "complete_exact_runtime_closure": { "const": true },
                  "state": { "const": "COMPLETE_EXACT_RUNTIME_CLOSURE" },
                  "unresolved_native_dependency_edge_count": { "const": 0 }
                }
              }
            }
          },
          "independent_review": {
            "properties": {
              "required_next_evidence": {
                "const": [
                  "INDEPENDENT_NUMERIC_BUDGET_APPROVAL",
                  "REPRESENTATIVE_WORKLOAD_ADEQUACY_EVIDENCE",
                  "APPROVED_REVIEW_POLICY_AND_TRUSTED_KEY_CUSTODY",
                  "SIGNED_REVIEW_RECEIPT_BOUND_TO_SELECTED_COMMIT_TREE_CENSUS_AND_MEASUREMENTS",
                  "SELECTED_COMMIT_BINDING"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "executable_statements", "path", "role", "sha256"],
      "properties": {
        "bytes": { "$ref": "#/$defs/positiveInteger" },
        "executable_statements": { "$ref": "#/$defs/positiveInteger" },
        "path": { "type": "string", "pattern": "^cisco_toolkit/[A-Za-z0-9_.-]+\\.py$" },
        "role": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "embeddedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "executable_statements", "identifier", "role", "sha256"],
      "properties": {
        "bytes": { "$ref": "#/$defs/positiveInteger" },
        "executable_statements": { "$ref": "#/$defs/positiveInteger" },
        "identifier": { "const": "transition_legacy._PINNED_RELEASE1_DRIVER" },
        "role": { "const": "CONDITIONAL_RELEASE1_ISOLATED_DRIVER" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "guardSet": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "integer", "minimum": 1 },
          { "type": "string", "minLength": 1 }
        ]
      },
      "required": ["state"]
    },
    "dslGuardSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_program_bytes",
        "max_input_bytes",
        "max_output_bytes",
        "max_rules",
        "max_expression_depth",
        "max_expression_nodes",
        "max_operator_operands",
        "max_path_segments",
        "max_string_bytes",
        "max_set_items",
        "max_input_nodes",
        "max_instruction_fuel",
        "profile",
        "state"
      ],
      "properties": {
        "max_program_bytes": { "$ref": "#/$defs/positiveInteger" },
        "max_input_bytes": { "$ref": "#/$defs/positiveInteger" },
        "max_output_bytes": { "$ref": "#/$defs/positiveInteger" },
        "max_rules": { "$ref": "#/$defs/positiveInteger" },
        "max_expression_depth": { "$ref": "#/$defs/positiveInteger" },
        "max_expression_nodes": { "$ref": "#/$defs/positiveInteger" },
        "max_operator_operands": { "$ref": "#/$defs/positiveInteger" },
        "max_path_segments": { "$ref": "#/$defs/positiveInteger" },
        "max_string_bytes": { "$ref": "#/$defs/positiveInteger" },
        "max_set_items": { "$ref": "#/$defs/positiveInteger" },
        "max_input_nodes": { "$ref": "#/$defs/positiveInteger" },
        "max_instruction_fuel": { "$ref": "#/$defs/positiveInteger" },
        "profile": { "const": "DEFAULT_DSL_PROTOTYPE_LIMITS" },
        "state": { "const": "PROVISIONAL_MEASURED_NOT_REVIEWED_BUDGET" }
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "path", "role", "sha256"],
      "properties": {
        "bytes": { "$ref": "#/$defs/positiveInteger" },
        "path": { "type": "string", "pattern": "^(cisco_toolkit|tools)/[A-Za-z0-9_./-]+$" },
        "role": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_record_bytes", "metadata_record_sha256", "name", "version"],
      "properties": {
        "metadata_record_bytes": { "$ref": "#/$defs/positiveInteger" },
        "metadata_record_sha256": { "$ref": "#/$defs/digest" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeInventorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_digest",
        "blind_spot_count",
        "claim_boundary",
        "complete_exact_runtime_closure",
        "native_dependency_edge_count",
        "python_module_count",
        "runtime_file_count",
        "state",
        "unresolved_native_dependency_edge_count"
      ],
      "properties": {
        "asset_digest": { "$ref": "#/$defs/digest" },
        "blind_spot_count": { "$ref": "#/$defs/nonnegativeInteger" },
        "claim_boundary": { "type": "string", "minLength": 1 },
        "complete_exact_runtime_closure": { "type": "boolean" },
        "native_dependency_edge_count": { "$ref": "#/$defs/positiveInteger" },
        "python_module_count": { "$ref": "#/$defs/positiveInteger" },
        "runtime_file_count": { "$ref": "#/$defs/positiveInteger" },
        "state": {
          "enum": [
            "PARTIAL_NONPORTABLE_PROTOTYPE",
            "COMPLETE_EXACT_RUNTIME_CLOSURE"
          ]
        },
        "unresolved_native_dependency_edge_count": { "$ref": "#/$defs/nonnegativeInteger" }
      }
    },
    "nonnegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
