{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.invalid/schemas/atlas-r2-structural-tcb-census-v1.schema.json",
  "title": "Atlas R2 structural TCB census v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "budget_gate",
    "census_method",
    "conditional_legacy_replay_tcb",
    "implemented_guard_constants",
    "independent_review",
    "reference_runtime_dependencies",
    "reference_toolchain",
    "release3_included",
    "repository_basis",
    "structural_core"
  ],
  "properties": {
    "schema": { "const": "atlas.structural-tcb-census/1" },
    "release3_included": { "const": false },
    "budget_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_state", "core_sloc_budget", "pack_resource_ceilings", "pack_sloc_budget", "promotion_effect", "reason"],
      "properties": {
        "budget_state": { "const": "PENDING_EXECUTABLE_PACK_PROTOTYPE_AND_INDEPENDENT_REVIEW" },
        "core_sloc_budget": { "type": "null" },
        "pack_resource_ceilings": { "type": "null" },
        "pack_sloc_budget": { "type": "null" },
        "promotion_effect": { "const": "BLOCKS_R2_0_COMPLETION" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "census_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_statement_parser", "generator_bytes", "generator_path", "generator_sha256", "measurement_scope", "schema"],
      "properties": {
        "executable_statement_parser": { "type": "string", "pattern": "^coverage\\.py/[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "generator_bytes": { "$ref": "#/$defs/positiveInteger" },
        "generator_path": { "const": "tools/census_transition_tcb.py" },
        "generator_sha256": { "$ref": "#/$defs/digest" },
        "measurement_scope": { "const": "REFERENCE_ENVIRONMENT_OBSERVATION_WITH_PORTABLE_SOURCE_DIGEST_CHECK" },
        "schema": { "const": "atlas.python-executable-statement-census/1" }
      }
    },
    "conditional_legacy_replay_tcb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_source", "embedded_driver", "source_bundle_bytes", "source_bundle_file_count", "source_bundle_path", "source_bundle_sha256"],
      "properties": {
        "adapter_source": { "$ref": "#/$defs/source" },
        "embedded_driver": { "$ref": "#/$defs/embeddedSource" },
        "source_bundle_bytes": { "$ref": "#/$defs/positiveInteger" },
        "source_bundle_file_count": { "$ref": "#/$defs/positiveInteger" },
        "source_bundle_path": { "const": "cisco_toolkit/data/atlas-r1-source-bundle.json" },
        "source_bundle_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "implemented_guard_constants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_json", "content_set", "legacy_replay"],
      "properties": {
        "canonical_json": { "$ref": "#/$defs/guardSet" },
        "content_set": { "$ref": "#/$defs/guardSet" },
        "legacy_replay": { "$ref": "#/$defs/guardSet" }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_next_evidence", "result", "review_evidence"],
      "properties": {
        "required_next_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "result": { "const": "PENDING_BOUND_INDEPENDENT_REVIEW_EVIDENCE" },
        "review_evidence": { "type": "null" }
      }
    },
    "reference_runtime_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/distribution" }
    },
    "reference_toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_tag", "executable_bytes", "executable_sha256", "implementation", "platform_machine", "platform_system", "python_version"],
      "properties": {
        "cache_tag": { "type": "string", "minLength": 1 },
        "executable_bytes": { "$ref": "#/$defs/positiveInteger" },
        "executable_sha256": { "$ref": "#/$defs/digest" },
        "implementation": { "type": "string", "minLength": 1 },
        "platform_machine": { "type": "string", "minLength": 1 },
        "platform_system": { "type": "string", "minLength": 1 },
        "python_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "repository_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_commit", "source_basis_parent_sha", "state"],
      "properties": {
        "selected_commit": { "type": "null" },
        "source_basis_parent_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "state": { "const": "EXACT_INPUT_DIGESTS_AWAIT_EXTERNAL_SELECTED_COMMIT_BINDING" }
      }
    },
    "structural_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_statements", "sources"],
      "properties": {
        "executable_statements": { "$ref": "#/$defs/positiveInteger" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    }
  },
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "executable_statements", "path", "role", "sha256"],
      "properties": {
        "bytes": { "$ref": "#/$defs/positiveInteger" },
        "executable_statements": { "$ref": "#/$defs/positiveInteger" },
        "path": { "type": "string", "pattern": "^cisco_toolkit/[A-Za-z0-9_.-]+\\.py$" },
        "role": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "embeddedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "executable_statements", "identifier", "role", "sha256"],
      "properties": {
        "bytes": { "$ref": "#/$defs/positiveInteger" },
        "executable_statements": { "$ref": "#/$defs/positiveInteger" },
        "identifier": { "const": "transition_legacy._PINNED_RELEASE1_DRIVER" },
        "role": { "const": "CONDITIONAL_RELEASE1_ISOLATED_DRIVER" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "guardSet": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "integer", "minimum": 1 },
          { "type": "string", "minLength": 1 }
        ]
      },
      "required": ["state"]
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_record_bytes", "metadata_record_sha256", "name", "version"],
      "properties": {
        "metadata_record_bytes": { "$ref": "#/$defs/positiveInteger" },
        "metadata_record_sha256": { "$ref": "#/$defs/digest" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
