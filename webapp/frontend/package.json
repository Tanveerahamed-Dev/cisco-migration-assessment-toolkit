    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
