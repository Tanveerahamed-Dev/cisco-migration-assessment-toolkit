{
  "name": "assesshub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AssessHub — web cockpit for the Cisco Migration-Assessment engine.",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "api:generate": "node scripts/generate-api-types.mjs",
    "api:check": "node scripts/generate-api-types.mjs --check",
    "verify:node": "node scripts/verify-node.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "serve:visual": "vite --config vite.visual.config.ts",
    "test": "node --test scripts/generation-policy.test.mjs && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual:types": "tsc -p tsconfig.visual.json",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-force-graph-3d": "^1.29.1",
    "react-router": "8.3.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
