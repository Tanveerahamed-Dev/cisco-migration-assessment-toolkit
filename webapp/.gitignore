# AssessHub generated / local artifacts
frontend/node_modules/
# The production SPA is a shipped runtime asset. Keep it versioned so wheels and
# sdists built without Node are complete and byte-reviewable.
frontend/.vite/
*.tsbuildinfo
# The local SQLite store (assesshub.db and its backups). The comment used to share the
# pattern's line, and an inline # is part of a .gitignore pattern, so data/ was never ignored.
# The README stays visible.
data/*
!data/README.md
*.db
__pycache__/
.pytest_cache/
