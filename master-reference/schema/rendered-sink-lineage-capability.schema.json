rm_id": "pdf.capability_entry_boundary/1"}, {"field": "mutates_assessment_truth", "slot_template": "pdf.capabilities.capability.entry.cap.engine.training-curriculum.mutates_assessment_truth", "transform_id": "pdf.capability_entry_boundary/1"}], "expected_inputs": 2}]} }}]},
