{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/chunk.schema.json",
  "title": "Atlas deterministic record chunk",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "source_commit",
    "source_tree_digest",
    "chunk_index",
    "chunk_count",
    "record_count",
    "records_digest",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "source_tree_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chunk_index": {"type": "integer", "minimum": 0},
    "chunk_count": {"type": "integer", "minimum": 1},
    "record_count": {"type": "integer", "minimum": 1},
    "records_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of canonical ordered record-ID array; the enclosing receipt binds full bytes."},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "atlas-records.schema.json#/$defs/baseRecord"}
    }
  },
  "additionalProperties": false
}
