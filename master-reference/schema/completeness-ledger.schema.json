{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/completeness-ledger.schema.json",
  "title": "Atlas repository compilation completeness ledger",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "source_commit",
    "head_tree_oid",
    "index_digest",
    "source_tree_digest",
    "tracked_status_digest",
    "tracked_worktree_dirty",
    "hard_failure",
    "fatal_errors",
    "census",
    "parsing",
    "semantic_accounting",
    "record_counts",
    "graphify",
    "architecture_conformance",
    "privacy",
    "invariants",
    "acceptance_gates"
  ],
  "properties": {
    "id": {"$ref": "atlas-records.schema.json#/$defs/atlasId"},
    "schema_version": {"const": "1.1.0"},
    "source_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
    "head_tree_oid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
    "index_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_tree_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "tracked_status_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "tracked_worktree_dirty": {"type": ["boolean", "null"]},
    "hard_failure": {"type": "boolean"},
    "fatal_errors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "census": {
      "type": "object",
      "required": ["tracked_files", "classified_files", "full_exposure_files", "metadata_only_files"],
      "properties": {
        "tracked_files": {"type": "integer", "minimum": 0},
        "classified_files": {"type": "integer", "minimum": 0},
        "full_exposure_files": {"type": "integer", "minimum": 0},
        "metadata_only_files": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "parsing": {
      "type": "object",
      "required": [
        "status_counts",
        "parser_counts",
        "expected_nonblank_lines",
        "line_records",
        "lines_with_explicit_unresolved_reasons"
      ],
      "properties": {
        "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "parser_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "expected_nonblank_lines": {"type": "integer", "minimum": 0},
        "line_records": {"type": "integer", "minimum": 0},
        "lines_with_explicit_unresolved_reasons": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "semantic_accounting": {
      "type": "object",
      "required": [
        "symbol_records",
        "symbol_dossiers",
        "safe_parsed_sources",
        "structural_root_entities",
        "structural_root_kind_counts",
        "structurally_mapped_lines",
        "line_explanation_depth_counts",
        "symbol_explanation_depth_counts",
        "critical_or_public_symbols",
        "critical_level_four_reviews",
        "gui_surface_records",
        "gui_dossiers",
        "gui_dossier_evidence_state_counts",
        "gui_dossier_field_state_counts",
        "runtime_trace_state",
        "coverage_evidence_state",
        "consequential_claim_denominator_state",
        "typed_claim_records",
        "bitemporal_event_ledger_state",
        "bitemporal_event_records",
        "release_lifecycle_transition_receipt_state"
      ],
      "properties": {
        "symbol_records": {"type": "integer", "minimum": 0},
        "symbol_dossiers": {"type": "integer", "minimum": 0},
        "safe_parsed_sources": {"type": "integer", "minimum": 0},
        "structural_root_entities": {"type": "integer", "minimum": 0},
        "structural_root_kind_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "structurally_mapped_lines": {"type": "integer", "minimum": 0},
        "line_explanation_depth_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "symbol_explanation_depth_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "critical_or_public_symbols": {"type": "integer", "minimum": 0},
        "critical_level_four_reviews": {"type": "integer", "minimum": 0},
        "gui_surface_records": {"type": "integer", "minimum": 0},
        "gui_dossiers": {"type": "integer", "minimum": 0},
        "gui_dossier_evidence_state_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "gui_dossier_field_state_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "runtime_trace_state": {"type": "string"},
        "coverage_evidence_state": {"type": "string"},
        "consequential_claim_denominator_state": {"const": "not_declared"},
        "typed_claim_records": {"type": "integer", "minimum": 0},
        "bitemporal_event_ledger_state": {"const": "not_populated"},
        "bitemporal_event_records": {"const": 0},
        "release_lifecycle_transition_receipt_state": {"const": "not_integrated"}
      },
      "additionalProperties": false
    },
    "record_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "graphify": {"$ref": "#/$defs/sourceBoundCompilerReceipt"},
    "architecture_conformance": {"$ref": "#/$defs/sourceBoundCompilerReceipt"},
    "privacy": {"type": "object"},
    "invariants": {
      "allOf": [
        {"$ref": "#/$defs/gates"},
        {
          "contains": {
            "type": "object",
            "required": ["name"],
            "properties": {"name": {"const": "every_safe_parsed_source_has_one_structural_root"}}
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["name"],
            "properties": {"name": {"const": "every_safe_line_structurally_mapped"}}
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["name"],
            "properties": {"name": {"const": "every_gui_surface_has_standardized_evidence_honest_dossier"}}
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "acceptance_gates": {"$ref": "#/$defs/gates"}
  },
  "$defs": {
    "sourceBoundCompilerReceipt": {
      "type": "object",
      "required": ["schema_version", "source_commit", "source_tree_digest"],
      "properties": {
        "schema_version": {"const": "1.1.0"},
        "source_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "source_tree_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "gateValue": {"type": ["integer", "boolean", "null"]},
    "gate": {
      "type": "object",
      "required": ["name", "passed", "expected", "actual"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "expected": {"$ref": "#/$defs/gateValue"},
        "actual": {"$ref": "#/$defs/gateValue"}
      },
      "additionalProperties": false
    },
    "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/gate"}}
  },
  "additionalProperties": false
}
