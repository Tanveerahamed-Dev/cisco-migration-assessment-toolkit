{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/rendered-sink-lineage-contract/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "state", "closes_global_gate", "global_denominator", "source_scope", "sink_universe", "sinks", "limitations"],
  "properties": {
    "schema_version": {"const": "rendered-sink-lineage-contract/1.0.0"},
    "id": {"const": "atlas.rendered-sink-lineage.open-horizon.v1"},
    "state": {"const": "declared_incomplete"},
    "closes_global_gate": {"const": false},
    "global_denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expected_candidates", "in_scope_candidates", "out_of_scope_candidates", "independently_reviewed", "unresolved", "claim_contract_digest", "classification_digest", "source_receipts_digest", "candidate_set_digest"],
      "properties": {
        "kind": {"const": "bounded_curated_content_claim_denominator"},
        "expected_candidates": {"const": 2136},
        "in_scope_candidates": {"const": 315},
        "out_of_scope_candidates": {"const": 1821},
        "independently_reviewed": {"const": 0},
        "unresolved": {"const": 2136},
        "claim_contract_digest": {"const": "4ebd7da5caa6aab63f3ba122d480fef638f46b866c665845087433074f436c8d"},
        "classification_digest": {"const": "b5bc4783b8bd6461fc4669b39a555ae061081a278e36712cdb6f70a5e673d1df"},
        "source_receipts_digest": {"const": "863f93c7bc0599b1cfe7e5b42eb5b10c8087a704af9de194be18d9bf28008689"},
        "candidate_set_digest": {"const": "a768b5a6c9a94390ada8e9c24627c8908f6a7b51e3f06d59b79ac8f1a5ffdd43"}
      }
    },
    "source_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_blob_oid", "sha256", "expected_records", "expected_candidates", "expected_safety_inputs", "candidate_digest", "facet_id_set_digest", "candidate_rules", "safety_rules"],
      "properties": {
        "path": {"const": "master-reference/content/open-horizon-register.json"},
        "git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "expected_records": {"const": 65},
        "expected_candidates": {"const": 315},
        "expected_safety_inputs": {"const": 53},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "facet_id_set_digest": {"$ref": "#/$defs/digest"},
        "candidate_rules": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/candidateRule"}},
        "safety_rules": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/safetyRule"}}
      }
    },
    "sink_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "declared_count", "known_omitted_classes"],
      "properties": {
        "complete": {"const": false},
        "declared_count": {"const": 2},
        "known_omitted_classes": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}
      }
    },
    "sinks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/sink"}, {"properties": {"sink_id": {"const": "pdf.open-horizon"}}, "required": ["sink_id"]}]},
        {"allOf": [{"$ref": "#/$defs/sink"}, {"properties": {"sink_id": {"const": "web.gaps.open-horizon"}}, "required": ["sink_id"]}]}
      ],
      "items": false
    },
    "limitations": {"type": "array", "minItems": 4, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/nonblank"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"},
    "nonblank": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?=.*[^ \\t\\n\\r]).+$"},
    "fieldName": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "candidateRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "record_kind", "selector", "identity", "expected_records", "candidate_fields"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/token"},
        "record_kind": {"$ref": "#/$defs/token"},
        "selector": {"$ref": "#/$defs/fieldName"},
        "identity": {"enum": ["root", "id"]},
        "expected_records": {"type": "integer", "minimum": 1, "maximum": 100},
        "candidate_fields": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/fieldName"}}
      }
    },
    "expectedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "expected_value"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldName"},
        "expected_value": {"type": ["string", "boolean"]}
      }
    },
    "safetyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "selector", "identity", "expected_records", "fields"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/token"},
        "selector": {"$ref": "#/$defs/fieldName"},
        "identity": {"enum": ["root", "id"]},
        "expected_records": {"type": "integer", "minimum": 1, "maximum": 100},
        "fields": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/expectedField"}}
      }
    },
    "renderedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facet_path", "disposition", "slot_template", "transform_id"],
      "properties": {
        "facet_path": {"$ref": "#/$defs/fieldName"},
        "disposition": {"enum": ["rendered_identity", "rendered_labeled", "rendered_ordered_array", "rendered_derived"]},
        "slot_template": {"$ref": "#/$defs/nonblank"},
        "transform_id": {"$ref": "#/$defs/token"}
      }
    },
    "renderedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "fields", "expected_subjects"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/token"},
        "fields": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/renderedField"}},
        "expected_subjects": {"type": "integer", "minimum": 1, "maximum": 315}
      }
    },
    "omissionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "facet_paths", "expected_subjects", "reason_code"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/token"},
        "facet_paths": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/fieldName"}},
        "expected_subjects": {"type": "integer", "minimum": 1, "maximum": 315},
        "reason_code": {"const": "sink_v1_not_rendered"}
      }
    },
    "safetyField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "slot_template", "transform_id"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldName"},
        "slot_template": {"$ref": "#/$defs/nonblank"},
        "transform_id": {"$ref": "#/$defs/token"}
      }
    },
    "safetyMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "fields", "expected_inputs"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/token"},
        "fields": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/safetyField"}},
        "expected_inputs": {"type": "integer", "minimum": 1, "maximum": 53}
      }
    },
    "sink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sink_id", "kind", "locator", "renderer_path", "renderer_symbol", "expected_rendered", "expected_omitted", "rendered_rules", "omission_rules", "safety_mappings"],
      "properties": {
        "sink_id": {"$ref": "#/$defs/token"},
        "kind": {"$ref": "#/$defs/token"},
        "locator": {"$ref": "#/$defs/nonblank"},
        "renderer_path": {"type": "string", "pattern": "^master-reference/[a-zA-Z0-9._/-]+$"},
        "renderer_symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
        "expected_rendered": {"const": 167},
        "expected_omitted": {"const": 148},
        "rendered_rules": {"type": "array", "minItems": 3, "maxItems": 16, "items": {"$ref": "#/$defs/renderedRule"}},
        "omission_rules": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/omissionRule"}},
        "safety_mappings": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/safetyMapping"}}
      }
    }
  }
}
