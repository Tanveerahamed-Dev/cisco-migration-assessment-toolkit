{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/family-attestation/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "source_commit", "source_tree_digest", "output_contract", "covered_receipts", "self_exclusions", "closure"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "kind": {"const": "complete-family-membership-and-pre-manifest-receipt"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "source_tree_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "catalog_version", "expected_members"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "catalog_version": {"type": "string", "minLength": 1},
        "expected_members": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "covered_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "self_exclusions": {"type": "array", "items": {"type": "string"}},
    "closure": {"type": "string", "minLength": 1}
  }
}
