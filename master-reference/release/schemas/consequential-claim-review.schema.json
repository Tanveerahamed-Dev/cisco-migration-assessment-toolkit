{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/consequential-claim-review/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_kind", "purpose", "source_commit", "source_tree_digest", "contract_path", "subject_contract_version", "contract_git_blob_oid", "contract_digest", "classification_digest", "source_receipts_digest", "candidate_set_digest", "candidate_count", "records_digest", "records"],
  "properties": {
    "schema_version": {"const": "consequential-claim-review/1"},
    "review_kind": {"const": "bounded_curated_consequential_claim_review"},
    "purpose": {"const": "consequential_claim_review"},
    "source_commit": {"$ref": "#/$defs/gitOid"},
    "source_tree_digest": {"$ref": "#/$defs/digest"},
    "contract_path": {"const": "master-reference/governance/consequential-claim-contract.json"},
    "subject_contract_version": {"const": "bounded-curated-consequential-claims/2"},
    "contract_git_blob_oid": {"$ref": "#/$defs/gitOid"},
    "contract_digest": {"$ref": "#/$defs/digest"},
    "classification_digest": {"$ref": "#/$defs/digest"},
    "source_receipts_digest": {"$ref": "#/$defs/digest"},
    "candidate_set_digest": {"$ref": "#/$defs/digest"},
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 100000},
    "records_digest": {"$ref": "#/$defs/digest"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facet_id", "subject_digest", "value_digest", "grounding_digest", "verdict", "review_evidence_digest"],
      "properties": {
        "facet_id": {"type": "string", "pattern": "^urn:atlas:claim-facet:[0-9a-f]{64}$"},
        "subject_digest": {"$ref": "#/$defs/digest"},
        "value_digest": {"$ref": "#/$defs/digest"},
        "grounding_digest": {"$ref": "#/$defs/digest"},
        "verdict": {"enum": ["pass", "block", "abstain"]},
        "review_evidence_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
